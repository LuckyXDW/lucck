    "ruleContent": "<js>\nvar h = String(result);\nvar m = h.match(/<source[^>]*src=\"([^\"]+\\.m3u8[^\"]*)\"[^>]*type=\"application\\/x-mpegURL\"/);\nif (!m) m = h.match(/<source[^>]*type=\"application\\/x-mpegURL\"[^>]*src=\"([^\"]+\\.m3u8[^\"]*)\"/);\nvar url = m ? m[1] : '';\nvar p = h.match(/<video[^>]*poster=[\"']([^\"']+)[\"']/);\nvar poster = p ? p[1] : '';\nif (poster && poster.indexOf('http') != 0) {\n    poster = 'https://ptt2.my' + poster;\n}\n`<link rel=\"stylesheet\" type=\"text/css\" href=\"https://muiplayer.js.org/css/mui-player.min.css\" />\n<style>html,body{height:100%!important;margin:0!important;padding:0!important;background:#000!important;}#wrap{position:fixed!important;top:50%!important;left:50%!important;transform:translate(-50%,-50%)!important;width:100%!important;max-width:640px!important;z-index:9999!important;}</style>\n<script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js\"></script>\n<script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/gh/ljun223/reader3@main/js/mui-player.min.js\"></script>\n<script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/gh/ljun223/reader3@main/js/mui-player-mobile-plugin.min.js\"></script>\n<div id=\"wrap\"><div id=\"mui-player\" style=\"width:100%;\"></div></div>\n<script>\nvar mp = new MuiPlayer({\n  \"container\": \"#mui-player\",\n  \"src\": \"${url}\",\n  \"poster\": \"${poster}\",\n  \"autoFit\": false,\n  \"lang\": \"zh-cn\",\n  \"parse\": {\n    \"type\": \"hls\",\n    \"loader\": Hls,\n    \"config\": { \"debug\": false }\n  },\n  plugins: [\n    new MuiPlayerMobilePlugin({\n      \"key\": \"01I01I01H01J01L01K01J01I01K01J01H01D01J01G01E\",\n      \"showMenuButton\": true,\n      \"pageGesture\": true\n    })\n  ]\n});\n</script>`\n</js>",
